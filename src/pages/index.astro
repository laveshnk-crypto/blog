---
import { type CollectionEntry, getCollection } from "astro:content";
import PostPreview from "@/components/blog/PostPreview.astro";
import Note from "@/components/note/Note.astro";
import SocialList from "@/components/SocialList.astro";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";
import "@/styles/intro.css";

// Posts
const MAX_POSTS = 10;
const allPosts = await getAllPosts();
const allPostsByDate = allPosts.sort(collectionDateSort) as CollectionEntry<"post">[];
const latestPosts = allPostsByDate.slice(0, MAX_POSTS);

// Pinned Posts, set to a max of 3;
const MAX_PINNED_POSTS = 3;
const pinnedPosts = allPostsByDate
	.values()
	.filter((p) => p.data.pinned)
	.take(MAX_PINNED_POSTS)
	.toArray();

// Notes, set to a max of 5
const MAX_NOTES = 5;
const allNotes = await getCollection("note");
const latestNotes = allNotes
	.sort(collectionDateSort)
	.slice(0, MAX_NOTES) as CollectionEntry<"note">[];
---

<!-- Full-Screen Intro Overlay (Placed OUTSIDE PageLayout to avoid CSS clipping) -->
<div id="intro-overlay" class="intro-overlay">
	<div class="container">
		<div class="loader"></div>
		<div class="loader"></div>
		<div class="loader"></div>
	</div>
</div>

<PageLayout meta={{ title: "Home" }}>
	<section class="mb-8">
		<p class="typewriter" style="--typewriter-chars: 52;">
			Hey ya'll, and welcome to my corner on the inter-webs. I'm a software and web developer based
			out of Ontario. Expect to see a variety of web-projects and other nerdy stuffs on here.
			<br /><br /> Stick around and check out some of my work below!
		</p>
	</section>

	<br /><SocialList />
	{
		pinnedPosts.length > 0 && (
			<section class="mt-16">
				<h2 class="title mb-6 text-xl">Pinned Posts</h2>
				<ul class="space-y-4" role="list">
					{pinnedPosts.map((p) => (
						<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
							<PostPreview post={p} />
						</li>
					))}
				</ul>
			</section>
		)
	}
	<section class="mt-16">
		<h2 class="title text-accent mb-6 text-xl"><a href="/posts/">Posts</a></h2>
		<ul class="space-y-4" role="list">
			{
				latestPosts.map((p) => (
					<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
						<PostPreview post={p} />
					</li>
				))
			}
		</ul>
	</section>
	{
		latestNotes.length > 0 && (
			<section class="mt-16">
				<h2 class="title text-accent mb-6 text-xl">
					<a href="/notes/">Notes</a>
				</h2>
				<ul class="space-y-6" role="list">
					{latestNotes.map((note) => (
						<li>
							<Note note={note} as="h3" isPreview />
						</li>
					))}
				</ul>
			</section>
		)
	}
</PageLayout>

<!-- Session Storage Check & Timed Exit Script -->
<!-- Timed Exit Script (Plays on EVERY refresh) -->
<!-- Timed Intro Script (Only plays once per tab session) -->
<script is:inline>
	const overlay = document.getElementById("intro-overlay");
	const hasVisited = sessionStorage.getItem("hasVisitedSession");

	if (hasVisited) {
		// RETURN VISIT IN THIS SESSION:
		// 1. Hide the intro overlay immediately
		if (overlay) overlay.style.display = "none";

		// 2. Add a class to <html> to immediately reveal all typewriter text
		document.documentElement.classList.add("skip-typewriter");
	} else {
		// FIRST VISIT IN THIS SESSION:
		// 1. Set typewriter delay to wait for the intro overlay (e.g., 2s)
		document.documentElement.style.setProperty("--typewriter-delay", "2s");

		// 2. Play intro animation
		if (overlay) {
			setTimeout(() => {
				overlay.classList.add("fade-out");
				setTimeout(() => {
					overlay.style.display = "none";
				}, 800);
			}, 2000);
		}

		// 3. Mark session as visited
		sessionStorage.setItem("hasVisitedSession", "true");
	}
</script>

<style is:global>
	/* Overlay wrapper positioning */
	.intro-overlay {
		position: fixed;
		inset: 0;
		z-index: 99999;
		display: flex;
		justify-content: center;
		align-items: center;
		/* Hardcode your dark background first, then let var() override it */
		background-color: #0d0f17;
		background-color: var(--color-global-bg, #0d0f17);
		transition: opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1);
		opacity: 1;
	}

	.intro-overlay.fade-out {
		opacity: 0;
		pointer-events: none;
	}
</style>
